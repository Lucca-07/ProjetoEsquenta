generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// No Evolution Go que hospeda as instancias desta KVM-8.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // ADMIN, USER
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EvolutionNode {
  id        String   @id @default(uuid())
  name      String   @unique
  baseUrl   String
  apiKey    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  numbers Number[]

  // Keep the existing physical table so deployments retain their node data.
  @@map("WahaNode")
}

// Um número/chip de WhatsApp gerenciado pelo sistema
model Number {
  id          String   @id @default(uuid())
  phone       String   @unique
  sessionName String   @unique
  nodeId      String
  node        EvolutionNode @relation(fields: [nodeId], references: [id])

  status String  @default("STARTING") // STARTING, SCAN_QR_CODE, WORKING, FAILED, STOPPED
  active Boolean @default(true)

  warmupDay      Int      @default(0)
  dailyTarget    Int      @default(0)
  dailySentCount Int      @default(0)
  lastResetAt    DateTime @default(now())

  intervalSeconds Int       @default(240)
  durationHours   Int       @default(24)
  warmupStartedAt DateTime?
  warmupFinishAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pairsAsA         WarmupPair[] @relation("PairNumberA")
  pairsAsB         WarmupPair[] @relation("PairNumberB")
  messagesSent     Message[]    @relation("Sender")
  messagesReceived Message[]    @relation("Receiver")
  logs             WarmupLog[]
  warmupGroups     WarmupGroupMember[]
}

// Um aquecimento reúne qualquer quantidade de números em uma única conversa.
model WarmupGroup {
  id              String   @id @default(uuid())
  name            String
  status          String   @default("ACTIVE") // ACTIVE, STOPPED, COMPLETED
  intervalSeconds Int      @default(240)
  durationHours   Int      @default(24)
  startedAt       DateTime @default(now())
  finishAt        DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members WarmupGroupMember[]
  messages Message[]
}

model WarmupGroupMember {
  id       String      @id @default(uuid())
  groupId  String
  numberId String
  group    WarmupGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  number   Number      @relation(fields: [numberId], references: [id], onDelete: Cascade)
  joinedAt DateTime    @default(now())

  @@unique([groupId, numberId])
  @@index([numberId])
}

// Par de números que "conversam" entre si para aquecer
model WarmupPair {
  id        String   @id @default(uuid())
  numberAId String
  numberBId String
  numberA   Number   @relation("PairNumberA", fields: [numberAId], references: [id])
  numberB   Number   @relation("PairNumberB", fields: [numberBId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([numberAId, numberBId])
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  receiverId  String
  groupId     String?
  sender      Number    @relation("Sender", fields: [senderId], references: [id])
  receiver    Number    @relation("Receiver", fields: [receiverId], references: [id])
  group       WarmupGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  content     String
  status      String    @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  waMessageId String?
  error       String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([groupId])
}

// Banco de frases usadas para gerar as mensagens de aquecimento (spintax)
model WarmupPhrase {
  id        String   @id @default(uuid())
  text      String // texto em spintax, ex: "{Oi|Olá}, tudo {bem|certo}?"
  category  String   @default("geral") // geral, saudacao, despedida, confirmacao...
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WarmupLog {
  id               String   @id @default(uuid())
  numberId         String
  number           Number   @relation(fields: [numberId], references: [id])
  day              Int
  messagesSent     Int      @default(0)
  messagesReceived Int      @default(0)
  event            String // DAY_ADVANCED, TARGET_REACHED, SEND_ERROR, SESSION_DOWN...
  detail           String?
  createdAt        DateTime @default(now())
}
