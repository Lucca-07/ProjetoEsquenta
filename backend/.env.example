# App
APP_ENV=production
LOG_LEVEL=INFO
EVOLUTION_GO_IMAGE=evoapicloud/evolution-go:0.7.1
EVOLUTION_GO_NODE1_API_KEY=CHANGE_ME
EVOLUTION_GO_DB_PASSWORD=CHANGE_ME
# EVOLUTION_OPERATOR_EMAIL=seu-email@example.com

# Banco (roda no Servidor 1, junto com API/Redis/workers)
DATABASE_URL=postgresql://esquenta:CHANGE_ME@postgres:5432/esquenta

# Redis (roda no Servidor 1)
REDIS_URL=redis://redis:6379/0

# API key simples para proteger os endpoints (opcional)
API_KEY=CHANGE_ME

# Nos Evolution Go: kvm8-1 = local, kvm8-2 = servidor remoto
# Ajuste os IPs/portas conforme sua infraestrutura real.
EVOLUTION_GO_NODES=[{"name":"kvm8-1","base_url":"http://evolution-go-node1:8080","api_key":"CHANGE_ME"},{"name":"kvm8-2","base_url":"http://SEU_IP_SERVIDOR_2:8080","api_key":"CHANGE_ME"}]

# Rampa de aquecimento
WARMUP_START_MESSAGES=5
WARMUP_INCREMENT=4
WARMUP_MAX_MESSAGES=120
WARMUP_MAX_DAYS=30

# Janela de funcionamento (hora local do servidor, 0-23)

# Delay entre mensagens (segundos)

SCHEDULER_INTERVAL_SECONDS=60
