# App
APP_ENV=production
LOG_LEVEL=INFO
EVOLUTION_GO_IMAGE=evoapicloud/evolution-go:0.7.2
EVOLUTION_GO_NODE1_API_KEY=CHANGE_ME
EVOLUTION_GO_DB_PASSWORD=CHANGE_ME
# EVOLUTION_OPERATOR_EMAIL=seu-email@example.com

# Banco da aplicacao, executado na mesma KVM-8.
DATABASE_URL=postgresql://esquenta:CHANGE_ME@postgres:5432/esquenta

# Redis executado na mesma KVM-8.
REDIS_URL=redis://redis:6379/0

# API key simples para proteger os endpoints (opcional)
API_KEY=CHANGE_ME

# Unico no Evolution Go, executado nesta KVM-8.
EVOLUTION_GO_NODES=[{"name":"kvm8-1","base_url":"http://evolution-go-node1:8080","api_key":"CHANGE_ME"}]

# Rampa de aquecimento
WARMUP_START_MESSAGES=5
WARMUP_INCREMENT=4
WARMUP_MAX_MESSAGES=120
WARMUP_MAX_DAYS=30

# Janela de funcionamento (hora local do servidor, 0-23)

# Delay entre mensagens (segundos)

SCHEDULER_INTERVAL_SECONDS=60
